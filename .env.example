# Node 22+ supports: node --env-file=.env index.js
MONGODB_URI=mongodb://127.0.0.1:27017/store
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Required in production: generate a unique secret of at least 32 characters.
# SESSION_SECRET=
# Set only behind one trusted reverse proxy; production requires HTTPS.
TRUST_PROXY=0
